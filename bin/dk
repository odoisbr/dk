#!/usr/bin/env python3
"""CLI do dk. Simula por padrão; `--apply` é explícito."""
from __future__ import annotations
import argparse
import datetime
import json
import subprocess
import sys
from pathlib import Path
from shutil import which

RAIZ = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(RAIZ))

from core import (changeset, cobertura, conformidade,  # noqa: E402
                  consistencia, deck, documento, entregaveis, espinha, ids,
                  inception, io, lacunas, leitura, mapa, ops, padrao, prontidao,
                  prototipo, similares,
                  rastreabilidade, registry, scan)
from core import git as vcs  # noqa: E402


def cmd_handoff(args) -> int:
    projeto = Path(args.projeto).resolve()

    if args.matriz:
        print(rastreabilidade.markdown(rastreabilidade.matriz(projeto)))
        return 0

    r = prontidao.avaliar(projeto)
    marcas = {'ok': '[x]', 'aviso': '[!]', 'bloqueio': '[ ]'}
    for i in r['itens']:
        print(f"{marcas[i['estado']]} {i['nome']}: {i['evidencia']}")
        if i['estado'] != 'ok':
            print(f"      resolve em `{i['resolve_em']}` — {i['comando']}")

    if not r['pronto']:
        print(f"\n{len(r['bloqueios'])} bloqueio(s) — o pacote de handoff "
              'não foi gerado.')
        return 1

    if r['avisos']:
        print(f"\n{len(r['avisos'])} aviso(s) — o pacote sai, com ressalva.")

    if not args.corpo:
        print('\ngate aberto. Rode de novo com --corpo <arquivo.md> para gerar '
              'o pacote.')
        return 0

    corpo = Path(args.corpo).read_text(encoding='utf-8')
    if '{{RASTREABILIDADE}}' in corpo:
        corpo = corpo.replace(
            '{{RASTREABILIDADE}}',
            rastreabilidade.markdown(rastreabilidade.matriz(projeto)))

    achados = entregaveis.validar('handoff', corpo)
    for a in achados:
        print(f"{a['id']}: {a['titulo']} — {a['evidencia']}")
    if [a for a in achados if a['impacto'] == 'alto']:
        print('o pacote não foi gerado.')
        return 1

    html = documento.montar('Handoff para Desenvolvimento', projeto.name, corpo,
                            {'Projeto': projeto.name, 'Gerado em': _hoje()})
    pasta = padrao.destino('handoff')
    alvo = projeto / pasta / f'handoff-{_hoje_iso()}.html'

    reg = leitura.Registro()
    fontes = []
    if alvo.exists():
        reg.ler(alvo)
        fontes.append(alvo)
    op = ops.Operacao(projeto, escopo=[pasta], registro=reg, fontes=fontes)
    plano = op.planejar(alvo, html)
    print(f"{plano['acao']}: {plano['caminho']}")

    if not args.apply:
        print('simulação — nada foi gravado. Use --apply para aplicar.')
        return 0

    op.aplicar()
    print(f'gravado: {alvo.relative_to(projeto)}')
    return 0


def cmd_prototipar(args) -> int:
    projeto = Path(args.projeto).resolve()

    if args.verificar:
        achados = prototipo.verificar(projeto)
        for a in achados:
            print(f"regra {a['regra']}: {a['titulo']}")
            print(f"  {a['evidencia']}")
        altos = [a for a in achados if a['impacto'] == 'alto']
        print(f'{len(achados)} achado(s) · {len(altos)} de impacto alto')
        return 1 if achados else 0

    if not args.changeset:
        print('sem --changeset não há mudança a abrir. '
              'Use --verificar para só conferir o padrão.')
        return 1

    cs = changeset.abrir(args.changeset, args.titulo, args.origem,
                         args.alvo or [])
    problemas = changeset.validar(cs)
    for a in problemas:
        print(f"{a['id']}: {a['titulo']} — {a['evidencia']}")
    if problemas:
        print(f'{len(problemas)} problema(s) — o changeset não foi aberto.')
        return 1

    print(f"{cs['id']}: {cs['title']}")
    print(f"  origem: {cs['source']}")
    print(f"  affected: {', '.join(cs['affected'])}")

    fora = [a for a in prototipo.verificar(projeto) if a['impacto'] == 'alto']
    if fora:
        print(f'  atenção: {len(fora)} violação(ões) de padrão já existentes '
              'no protótipo — corrija-as neste changeset ou em outro')
        for a in fora:
            print(f"    regra {a['regra']}: {a['evidencia']}")

    if not args.apply:
        print('simulação — o changeset não foi gravado. '
              'Use --apply para abrir de fato.')
        return 0

    op = ops.Operacao(projeto, escopo=['.dk'], registro=leitura.Registro())
    op.planejar(projeto / '.dk' / 'changesets' / f"{cs['id']}.json",
                json.dumps(cs, ensure_ascii=False, indent=2) + '\n')
    op.aplicar()
    print(f"aberto: .dk/changesets/{cs['id']}.json")
    return 0


def _entender_inception(args, projeto: Path) -> int:
    r = inception.avaliar(projeto)
    if args.json:
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0
    print(f"inception: {r['cobertas']}/{r['total']} atividades "
          f"({r['percentual']}%) — {r['estado']}")
    marcas = {'coberta': '[x]', 'incompleta': '[!]', 'ausente': '[ ]'}
    for a in r['atividades']:
        n = f"{a['n']:>2}" if a['n'] else ' —'
        print(f"{marcas[a['estado']]} {n} {a['nome']}: {a['evidencia']}")
    for a in r['achados']:
        quem = ('código decidiu' if a['decidido_por'] == 'codigo'
                else 'candidato — a skill decide')
        print(f"\n{a['id']} [{a['impacto']}] ({quem}): {a['titulo']}")
        print(f"  {a['evidencia']}")
    return 0


def _entender_similares(args, projeto: Path) -> int:
    r = similares.avaliar(projeto)
    if args.json:
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0
    print(similares.matriz(projeto))
    for a in r['achados']:
        quem = ('código decidiu' if a['decidido_por'] == 'codigo'
                else 'candidato — a skill decide')
        print(f"{a['id']} [{a['impacto']}] ({quem}): {a['titulo']}")
        print(f"  {a['evidencia']}")
    return 0


def cmd_entender(args) -> int:
    projeto = Path(args.projeto).resolve()
    if args.inception:
        return _entender_inception(args, projeto)
    if args.similares:
        return _entender_similares(args, projeto)
    cob = cobertura.matriz(projeto)
    inc = consistencia.analisar(registry.carregar(projeto, 'regras'),
                                registry.carregar(projeto, 'requisitos'))
    lac = lacunas.analisar(projeto)

    if args.json:
        print(json.dumps({'cobertura': cob, 'consistencia': inc,
                          'lacunas': lac}, ensure_ascii=False, indent=2))
        return 0

    print(f"cobertura: {cob['totais']['regras']} regras · "
          f"{cob['totais']['requisitos']} requisitos")
    for rotulo, chave in (('regra sem requisito', 'regras_sem_requisito'),
                          ('requisito sem regra', 'requisitos_sem_regra'),
                          ('requisito fora do entregável',
                           'requisitos_sem_entregavel')):
        if cob[chave]:
            print(f"  {rotulo}: {', '.join(cob[chave])}")

    if inc:
        print(f'\nconsistência: {len(inc)} achado(s)')
        for a in inc:
            quem = ('código decidiu' if a['decidido_por'] == 'codigo'
                    else 'candidato — a skill decide')
            print(f"  {a['tipo']} [{a['urgencia']}] ({quem})")
            print(f"    {a['evidencia']}")

    abertas = [a for a in lac if a['status'] != 'COBERTO']
    if abertas:
        print(f'\nlacunas: {len(abertas)} de {len(lac)} itens do checklist')
        ordem = {'CRITICA': 0, 'IMPORTANTE': 1, 'DESEJAVEL': 2}
        for a in sorted(abertas, key=lambda x: ordem[x['prioridade']]):
            print(f"  {a['id']} {a['tema']} [{a['status']}/{a['prioridade']}]")
            print(f"    {a['pergunta']}")
            print(f"    {a['evidencia']}")

    criticas = [a for a in lac
                if a['prioridade'] == 'CRITICA' and a['status'] == 'AUSENTE']
    bloqueios = [a for a in inc if a['urgencia'] == 'BLOQUEIA-AVANCO']
    print(f'\n{len(criticas)} lacuna(s) crítica(s) · '
          f'{len(bloqueios)} bloqueio(s) de avanço')
    return 0


def _hoje() -> str:
    return datetime.date.today().strftime('%d/%m/%Y')


def _hoje_iso() -> str:
    return datetime.date.today().isoformat()


def _renderizador_pdf() -> str:
    """Devolve o executável de PDF disponível, ou string vazia.

    Ausência não é erro: o HTML é o entregável canônico. O PDF é conveniência, e
    quando não dá para gerar, o dk diz — não falha em silêncio nem finge."""
    for candidato in ('chromium', 'chromium-browser', 'google-chrome',
                      'google-chrome-stable'):
        caminho = which(candidato)
        if caminho:
            return caminho
    macos = Path('/Applications/Google Chrome.app/Contents/MacOS/Google Chrome')
    return str(macos) if macos.exists() else ''


def _entregar_deck(args, projeto: Path) -> int:
    """Apresentação é a única saída do DK que não parte de prosa: o corpo é um
    JSON com `meta` e `slides`, porque slide é estrutura, não texto corrido."""
    try:
        dados = json.loads(Path(args.corpo).read_text(encoding='utf-8'))
    except json.JSONDecodeError as exc:
        print(f'o corpo da apresentação precisa ser JSON: {exc}')
        return 1

    slides = dados.get('slides') or []
    meta = dados.get('meta') or {}
    meta.setdefault('titulo', projeto.name)

    achados = deck.validar(slides)
    for a in achados:
        print(f"{a['id']} (slide {a['slide']}): {a['titulo']} — {a['evidencia']}")
    if [a for a in achados if a['impacto'] == 'alto']:
        print('a apresentação não foi gerada.')
        return 1

    pasta = entregaveis.destino('apresentacao')
    alvo = projeto / pasta / f'apresentacao-{_hoje_iso()}.html'
    reg = leitura.Registro()
    fontes = []
    if alvo.exists():
        reg.ler(alvo)
        fontes.append(alvo)
    op = ops.Operacao(projeto, escopo=[pasta], registro=reg, fontes=fontes)
    plano = op.planejar(alvo, deck.montar(meta, slides))
    print(f"{plano['acao']}: {plano['caminho']} · {len(slides)} slide(s)")

    if not args.apply:
        print('simulação — nada foi gravado. Use --apply para aplicar.')
        return 0
    op.aplicar()
    print(f'gravado: {alvo.relative_to(projeto)}')
    return 0


def cmd_entregar(args) -> int:
    projeto = Path(args.projeto).resolve()
    if args.tipo == 'apresentacao':
        return _entregar_deck(args, projeto)
    corpo_md = Path(args.corpo).read_text(encoding='utf-8')

    achados = entregaveis.validar(args.tipo, corpo_md)
    for a in achados:
        print(f"{a['id']}: {a['titulo']} — {a['evidencia']}")
    bloqueios = [a for a in achados if a['impacto'] == 'alto']
    if bloqueios:
        print(f'{len(bloqueios)} bloqueio(s) — o entregável não foi gerado.')
        return 1

    contrato = entregaveis.CONTRATOS[args.tipo]
    meta = {'Projeto': projeto.name, 'Gerado em': _hoje()}
    html = documento.montar(contrato['titulo'], projeto.name, corpo_md, meta)

    pasta = entregaveis.destino(args.tipo)
    alvo = projeto / pasta / f'{args.tipo}-{_hoje_iso()}.html'

    reg = leitura.Registro()
    fontes = []
    if alvo.exists():
        reg.ler(alvo)
        fontes.append(alvo)
    op = ops.Operacao(projeto, escopo=[pasta], registro=reg, fontes=fontes)
    plano = op.planejar(alvo, html)
    print(f"{plano['acao']}: {plano['caminho']}")

    if not args.apply:
        print('simulação — nada foi gravado. Use --apply para aplicar.')
        return 0

    op.aplicar()
    print(f'gravado: {alvo.relative_to(projeto)}')

    if args.pdf:
        renderizador = _renderizador_pdf()
        if not renderizador:
            print('PDF não gerado: nenhum renderizador encontrado. '
                  'O HTML é o entregável canônico e está completo.')
        else:
            destino_pdf = alvo.with_suffix('.pdf')
            r = subprocess.run(
                [renderizador, '--headless', '--disable-gpu',
                 f'--print-to-pdf={destino_pdf}', '--no-pdf-header-footer',
                 alvo.as_uri()],
                capture_output=True, text=True)
            if destino_pdf.exists():
                print(f'gravado: {destino_pdf.relative_to(projeto)}')
            else:
                print(f'PDF não gerado: o renderizador falhou ({r.returncode}). '
                      'O HTML está completo.')
    return 0


def _llms_do_projeto(m: dict, conf: dict) -> str:
    proj = m['projeto']
    linhas = ['# ' + Path(m['raiz']).name, '']
    if proj.get('stack'):
        linhas.append(f"Projeto {proj.get('tipo', 'indefinido')} — "
                      f"{', '.join(proj['stack'])}.")
    else:
        linhas.append(f"Projeto {proj.get('tipo', 'indefinido')}.")
    if proj.get('gerenciador'):
        linhas.append(f"Gerenciador: {proj['gerenciador']}.")
    linhas += ['', '## Conformidade com o DK', '',
               f"- Estado: {conf['classificacao']}"]
    for a in conf['artefatos']:
        linhas.append(f"- {a['caminho']} — {a['papel']}")
    if m['entrypoints']:
        linhas += ['', '## Entrypoints', '']
        linhas += [f'- {c}' for c in m['entrypoints']]
    if m['configs']:
        linhas += ['', '## Configuração', '']
        linhas += [f'- {c}' for c in m['configs']]
    if m['documentos']:
        linhas += ['', '## Documentos', '']
        linhas += [f'- {c}' for c in m['documentos'][:20]]
    linhas += ['', '## Custo de contexto', '',
               f"- {m['metricas']['arquivos']} arquivos mapeados",
               f"- {m['metricas']['tokens_estimados_total']} tokens no total "
               f"({m['metricas']['nota']})",
               f"- {m['metricas'].get('tokens_dos_importantes', 0)} tokens "
               'nos arquivos importantes', '']
    return '\n'.join(linhas)


def cmd_audit(args) -> int:
    projeto = Path(args.projeto).resolve()
    m = mapa.montar(projeto, nivel=args.nivel)
    m['raiz'] = str(projeto)
    conf = conformidade.avaliar(projeto, scan.varrer(projeto))

    if args.json:
        print(json.dumps({
            'projeto': m['projeto'], 'estrutura': m['estrutura'],
            'metricas': m['metricas'], 'conformidade': conf,
            'importantes': m['importantes'], 'ignorados': m['ignorados'],
        }, ensure_ascii=False, indent=2))
        return 0

    texto_llms = _llms_do_projeto(m, conf)

    # Um llms.txt escrito à mão não é sobrescrito às cegas: ele vira fonte
    # declarada, e o envelope recusa a gravação se ninguém o leu. Vale para o
    # próprio dk, que tem o seu.
    reg = leitura.Registro()
    fontes = []
    alvo_llms = projeto / 'llms.txt'
    if alvo_llms.exists():
        reg.ler(alvo_llms)
        fontes.append(alvo_llms)

    op = ops.Operacao(projeto, escopo=['.dk', 'llms.txt'],
                      registro=reg, fontes=fontes)
    planos = [
        op.planejar(projeto / '.dk' / 'mapa.json',
                    json.dumps(m, ensure_ascii=False, indent=2) + '\n'),
        op.planejar(projeto / 'llms.txt', texto_llms),
    ]

    proj = m['projeto']
    print(f"tipo: {proj.get('tipo')} · "
          f"stack: {', '.join(proj.get('stack') or []) or '—'} · "
          f"gerenciador: {proj.get('gerenciador') or '—'}")
    for ev in proj.get('evidencias', []):
        print(f'  evidência: {ev}')
    print(f"conformidade com o DK: {conf['classificacao']}")
    for a in conf['achados']:
        print(f"  {a['id']}: {a['titulo']} — {a['evidencia']}")
    print(f"{m['metricas']['arquivos']} arquivos · "
          f"{m['metricas']['tokens_estimados_total']} tokens "
          f"({m['metricas']['nota']})")
    for motivo, n in sorted(m['ignorados'].items()):
        print(f'  ignorados {n}: {motivo}')

    if not args.apply:
        for p in planos:
            print(f"{p['acao']}: {p['caminho']}")
        print('simulação — nada foi gravado. Use --apply para aplicar.')
        return 0

    op.aplicar()
    print('gravado: .dk/mapa.json e llms.txt')
    return 0


def _conciliar(projeto: Path, nome: str, prefixo: str, candidatos: list):
    """Dá id a cada candidato e funde no registro que o projeto já tem.

    Candidato cuja `origem_chave` já existe reusa o id que estava lá — é o que
    faz a revisão da mesma ata atualizar em vez de duplicar. Candidato novo pega
    o próximo id do contador do projeto: começar do 001 escrevia por cima do que
    o projeto já tinha."""
    atuais = registry.carregar(projeto, nome)
    por_chave = {i.get('origem_chave'): i for i in atuais if i.get('origem_chave')}
    contador = ids.base(projeto, prefixo, atuais)
    acoes = {'criado': 0, 'atualizado': 0}

    for candidato in candidatos:
        existente = por_chave.get(candidato.get('origem_chave'))
        if existente:
            candidato['id'] = existente['id']
        else:
            contador += 1
            candidato['id'] = f'{prefixo}-{contador:03d}'
        atuais, acao = registry.upsert(atuais, candidato)
        acoes[acao] += 1

    return atuais, acoes, contador


def cmd_levantar(args) -> int:
    projeto = Path(args.projeto).resolve()
    reg = leitura.Registro()

    fontes = []
    for nome in ('requisitos', 'regras'):
        p = registry.caminho(projeto, nome)
        if p.exists():
            reg.ler(p)
            fontes.append(p)

    canonico = registry.esquema(projeto) == 'canonico'
    prefixo_req = 'RF' if canonico else 'REQ'

    bruto = Path(args.insumo).read_text(encoding='utf-8')
    a = espinha.ata(bruto)
    try:
        origem = str(Path(args.insumo).resolve().relative_to(projeto))
    except ValueError:
        origem = Path(args.insumo).name
    novas_regras = espinha.regras(a, origem=origem)

    regras_atuais, acoes_r, ate_rn = _conciliar(projeto, 'regras', 'RN', novas_regras)
    novos_req = espinha.requisitos(novas_regras)
    req_atuais, acoes_q, ate_req = _conciliar(projeto, 'requisitos', prefixo_req,
                                              novos_req)
    acoes = {k: acoes_r[k] + acoes_q[k] for k in acoes_r}

    alvo_regras = registry.caminho(projeto, 'regras')
    alvo_req = registry.caminho(projeto, 'requisitos')
    escopo = sorted({str(alvo_regras.parent.relative_to(projeto)),
                     str(alvo_req.parent.relative_to(projeto))})
    op = ops.Operacao(projeto, escopo=escopo, registro=reg, fontes=fontes)
    esquema_alvo = registry.esquema(projeto)
    planos = [
        op.planejar(alvo_regras, json.dumps(
            [registry.para_esquema('regras', r, esquema_alvo) for r in regras_atuais],
            ensure_ascii=False, indent=2) + '\n'),
        op.planejar(alvo_req, json.dumps(
            [registry.para_esquema('requisitos', q, esquema_alvo) for q in req_atuais],
            ensure_ascii=False, indent=2) + '\n'),
    ]
    if canonico:
        contadores = ids.atualizar_contador(
            projeto, {'RN': ate_rn, prefixo_req: ate_req})
        planos.append(op.planejar(
            projeto / ids.CONTADORES,
            json.dumps(contadores, ensure_ascii=False, indent=2) + '\n'))

    if not args.apply:
        for p in planos:
            print(f"{p['acao']}: {p['caminho']}")
        print(f"regras {len(novas_regras)} · requisitos {len(novos_req)} · "
              f"criados {acoes['criado']} · atualizados {acoes['atualizado']}")
        print('simulação — nada foi gravado. Use --apply para aplicar.')
        return 0

    op.aplicar()
    print(f"gravado: criados {acoes['criado']}, atualizados {acoes['atualizado']}")
    return 0


def _bloqueia(achados) -> bool:
    for a in achados:
        print(f"{a['id']}: {a['titulo']} — {a['evidencia']}")
    return bool([a for a in achados if a['impacto'] == 'alto'])


def _git_estado(projeto: Path) -> int:
    st = vcs.estado(projeto)
    if not st['repositorio']:
        print(f'{projeto} não é um repositório git — '
              '`dk git --configurar --apply` inicia')
        return 1
    marca = ' (protegida)' if st['protegida'] else ''
    print(f"branch: {st['branch']}{marca}")
    print(f"alterados: {st['sujo']}")
    if st['upstream']:
        print(f"upstream: {st['upstream']} — {st['a_frente']} à frente, "
              f"{st['atras']} atrás")

    p = vcs.projeto_remoto(projeto)
    if p.get('caminho'):
        print(f"projeto: {p['grupo']}/{p['projeto']} em {p['host']}")
        print(f"web: {p['web']}")
    elif st['remoto']:
        print(f"remoto: {st['remoto']} — não reconhecido como GitLab")
    else:
        print('sem remote origin')

    conf = vcs.configuracao(projeto)
    if conf['faltando']:
        print('falta configurar: ' + ', '.join(conf['faltando']))
    else:
        print('git local configurado')
    return 0


def _git_configurar(args, projeto: Path) -> int:
    if not vcs.e_repositorio(projeto) and args.apply:
        subprocess.run(['git', 'init', '-q', str(projeto)], check=True)
        print(f'git init: {projeto}')
    elif not vcs.e_repositorio(projeto):
        print(f'git init: {projeto}')

    passos = []
    if args.nome:
        passos.append(['git', '-C', str(projeto), 'config', 'user.name', args.nome])
    if args.email:
        passos.append(['git', '-C', str(projeto), 'config', 'user.email', args.email])
    if args.remoto:
        acao = 'set-url' if vcs.estado(projeto).get('remoto') else 'add'
        passos.append(['git', '-C', str(projeto), 'remote', acao, 'origin',
                       args.remoto])
    for cmd in passos:
        print(' '.join(cmd[3:]))

    ignore = projeto / '.gitignore'
    conteudo = vcs.plano_gitignore(projeto)
    atual = ignore.read_text(encoding='utf-8') if ignore.exists() else ''
    if conteudo != atual:
        print(f'.gitignore: acrescenta padrão sensível '
              f'({len(conteudo.splitlines()) - len(atual.splitlines())} linhas)')

    if not args.apply:
        print('simulação — nada foi aplicado. Use --apply para aplicar.')
        return 0

    for cmd in passos:
        subprocess.run(cmd, check=True)
    if conteudo != atual:
        io.atomic_write(ignore, conteudo)
    print('git local configurado.')
    return _git_estado(projeto)


def _git_branch(args, projeto: Path) -> int:
    tipo = args.tipo or vcs.tipo_de_branch(args.branch)
    nome = vcs.nome_de_branch(tipo, args.branch)
    print(f'tipo: {tipo}')
    print(f'branch: {nome}')
    if not args.apply:
        print('simulação — nada foi criado. Use --apply para criar.')
        return 0
    r = subprocess.run(['git', '-C', str(projeto), 'checkout', '-b', nome],
                       capture_output=True, text=True)
    if r.returncode:
        print(r.stderr.strip())
        return 1
    print(f'criada e ativa: {nome}')
    return 0


def _git_commit(args, projeto: Path) -> int:
    if not args.arquivo:
        print('--commit exige --arquivo (repetível). '
              '`git add .` é proibido pela política.')
        return 1
    plano = vcs.plano_commit(projeto, args.arquivo, args.commit)
    print(f"branch: {plano['branch']}")
    for a in plano['arquivos']:
        print(f'  {a}')
    if plano['fora_do_diff']:
        print('fora do diff (nada a commitar): '
              + ', '.join(plano['fora_do_diff']))
    if _bloqueia(plano['bloqueios']):
        print('commit não foi feito.')
        return 1
    if not args.apply:
        print('simulação — nada foi commitado. Use --apply para commitar.')
        return 0
    subprocess.run(['git', '-C', str(projeto), 'add', '--', *args.arquivo],
                   check=True)
    r = subprocess.run(['git', '-C', str(projeto), 'commit', '-m', args.commit],
                       capture_output=True, text=True)
    print((r.stdout + r.stderr).strip())
    return r.returncode


def _git_push(args, projeto: Path) -> int:
    st = vcs.estado(projeto)
    if _bloqueia(vcs.guardar(projeto, 'push')):
        print('push não foi feito.')
        return 1
    p = vcs.projeto_remoto(projeto)
    if not p.get('caminho'):
        print('sem remote origin reconhecido — '
              '`dk git --configurar --remoto <url>`')
        return 1
    titulo = args.titulo or st['branch']
    cmd = vcs.comando_push_mr(st['branch'], titulo, alvo=args.alvo,
                              descricao=args.descricao)
    print(' '.join(cmd))
    print(f"abre merge request para {args.alvo} em {p['web']}")
    if not args.apply:
        print('simulação — nada foi enviado. Use --apply para enviar.')
        return 0
    r = subprocess.run(cmd, cwd=str(projeto), capture_output=True, text=True)
    saida = (r.stdout + r.stderr).strip()
    print(saida)
    if r.returncode:
        print(f"o push falhou. O MR pode ser aberto em {p['novo_mr']}")
    return r.returncode


def cmd_git(args) -> int:
    projeto = Path(args.projeto).resolve()
    if args.configurar:
        return _git_configurar(args, projeto)
    if not vcs.e_repositorio(projeto):
        return _git_estado(projeto)
    if args.branch:
        return _git_branch(args, projeto)
    if args.commit:
        return _git_commit(args, projeto)
    if args.push:
        return _git_push(args, projeto)
    return _git_estado(projeto)


def main() -> int:
    p = argparse.ArgumentParser(prog='dk')
    sub = p.add_subparsers(dest='cmd', required=True)
    lev = sub.add_parser('levantar', help='insumo de reunião → regras e requisitos')
    lev.add_argument('--projeto', required=True)
    lev.add_argument('--insumo', required=True)
    lev.add_argument('--apply', action='store_true',
                     help='aplica; sem esta flag, apenas simula')
    lev.set_defaults(func=cmd_levantar)

    aud = sub.add_parser('audit', help='mapeia o projeto e avalia conformidade')
    aud.add_argument('--projeto', required=True)
    aud.add_argument('--nivel', type=int, default=2, choices=(0, 1, 2))
    aud.add_argument('--json', action='store_true')
    aud.add_argument('--apply', action='store_true',
                     help='grava .dk/mapa.json e llms.txt; sem a flag, simula')
    aud.set_defaults(func=cmd_audit)

    ent = sub.add_parser('entregar', help='gera entregável formatado')
    ent.add_argument('--projeto', required=True)
    ent.add_argument('--tipo', required=True,
                     choices=sorted(list(entregaveis.CONTRATOS) + ['apresentacao']))
    ent.add_argument('--corpo', required=True)
    ent.add_argument('--pdf', action='store_true',
                     help='tenta gerar PDF; ausência de renderizador é anunciada')
    ent.add_argument('--apply', action='store_true')
    ent.set_defaults(func=cmd_entregar)

    und = sub.add_parser('entender', help='cobertura, consistência e lacunas')
    und.add_argument('--projeto', required=True)
    und.add_argument('--json', action='store_true')
    und.add_argument('--inception', action='store_true',
                     help='cobra a agenda da Lean Inception contra o registro')
    und.add_argument('--similares', action='store_true',
                     help='matriz de similares e procedência das observações')
    und.set_defaults(func=cmd_entender)

    pro = sub.add_parser('prototipar', help='changeset e padrão do protótipo')
    pro.add_argument('--projeto', required=True)
    pro.add_argument('--verificar', action='store_true',
                     help='só verifica o padrão do protótipo')
    pro.add_argument('--changeset')
    pro.add_argument('--titulo', default='')
    pro.add_argument('--origem', default='')
    pro.add_argument('--alvo', action='append',
                     help='caminho afetado; repetível. É o escopo da mudança')
    pro.add_argument('--apply', action='store_true')
    pro.set_defaults(func=cmd_prototipar)

    han = sub.add_parser('handoff', help='gate de prontidão e pacote de handoff')
    han.add_argument('--projeto', required=True)
    han.add_argument('--matriz', action='store_true',
                     help='só emite a matriz de rastreabilidade')
    han.add_argument('--corpo')
    han.add_argument('--apply', action='store_true')
    han.set_defaults(func=cmd_handoff)

    g = sub.add_parser('git', help='git local, projeto no GitLab, commit e MR')
    g.add_argument('--projeto', required=True)
    g.add_argument('--configurar', action='store_true',
                   help='prepara o git local: identidade, remoto e .gitignore')
    g.add_argument('--nome', help='user.name local')
    g.add_argument('--email', help='user.email local')
    g.add_argument('--remoto', help='URL do origin')
    g.add_argument('--branch', metavar='DESCRICAO',
                   help='classifica o pedido e nomeia a branch de trabalho')
    g.add_argument('--tipo', choices=sorted(vcs.TIPOS_BRANCH),
                   help='força o tipo em vez de classificar pelo texto')
    g.add_argument('--commit', metavar='MENSAGEM')
    g.add_argument('--arquivo', action='append',
                   help='arquivo que entra no commit; repetível e obrigatório')
    g.add_argument('--push', action='store_true',
                   help='envia a branch e abre o merge request')
    g.add_argument('--titulo', dest='titulo', default='')
    g.add_argument('--alvo', dest='alvo', default='main')
    g.add_argument('--descricao', default='')
    g.add_argument('--apply', action='store_true')
    g.set_defaults(func=cmd_git)

    args = p.parse_args()
    return args.func(args)


if __name__ == '__main__':
    sys.exit(main())
